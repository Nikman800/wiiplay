# Nintendo-owned or derived from Nintendo's code/data: never commit.
# Everything here is regenerated from the user's own disc by tools/reproduce.sh.

# Disc images and executables
*.rvz
*.iso
*.wbfs
*.ciso
*.gcz
*.wia
*.dol
*.rel
*.elf

# Extracted disc contents
/extracted/

# Disassembly, pseudocode and string dumps generated from the binary
/dtk/split/
/dtk/.tmp/
/dtk/index.json
/dtk/literals.json
/dtk/game_strings.txt
/decomp/
/decomp_typed/

# Tool runs and logs (contain decompiler output)
/rea/
*.log

# Local environment
__pycache__/
*.pyc
.vscode/
.idea/

# Build output (dtk split, objects, linked DOL)
/build/

# Generated by configure.py
/build.ninja
/compile_commands.json
/objdiff.json
/.ninja_*

# Reference tables from other decomps (re-fetched by tools/fetch_refs.sh; commits pinned in docs)
/ref/

# Generated naming context (re-run tools/lib_context.py)
/dtk/lib_naming/
